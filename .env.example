# Optional: minimum score for the last-chance full-index search (default 0.0 = any token overlap).
# STANDARDS_SEARCH_MIN_SCORE_RELAXED=0

# Optional OpenAI settings for conversational answer rewriting (post-retrieval).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
USE_OPENAI_ANSWER_REWRITER=0
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional Postgres/pgvector connection for production retrieval.
DATABASE_URL=postgresql://user:password@localhost:5432/standards_rag

# Authentication (optional for local dev; enable in AWS).
AUTH_REQUIRED=0
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=us-east-1

# Membership + subscription auth (GSI members / paying subscribers).
# Secret used to sign membership session tokens (set a strong value in prod).
MEMBERSHIP_JWT_SECRET=
# Demo mode returns the emailed 2FA code in API responses so the subscriber
# flow can be demoed without a mailbox. Turn OFF (0) once real email is wired.
MEMBERSHIP_DEMO_MODE=1
# Sender address for the per-login 2FA code, shared by every email provider.
# Accepts "Name <addr@domain>". Unset falls back to logging the code.
MEMBERSHIP_CODE_EMAIL_FROM=
# Email transport: auto | resend | smtp | ses | log. "auto" (default) picks
# Resend if RESEND_API_KEY is set, else SMTP if SMTP_HOST is set, else SES.
MEMBERSHIP_EMAIL_PROVIDER=auto
# Resend (default provider): sign up, verify a sending domain via 3 DNS records
# (automatic, no human review), then paste the key here. Free: 3,000/month.
RESEND_API_KEY=
# Generic SMTP relay (Brevo, Mailjet, SMTP2GO, Mailgun, Postmark, Gmail...).
# Use this when there is no sending domain yet. Port 465 = implicit TLS, else STARTTLS.
#
# THIS IS THE LIVE PROD SETUP: Gmail SMTP as the mailbox owner, which needs no
# domain at all and (unlike a third-party relay sending as a gmail.com address)
# aligns SPF/DKIM natively, so codes land in the inbox rather than spam.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=geosynthetic.institute@gmail.com
#   SMTP_PASSWORD=<Google *app password* — requires 2-Step Verification on the account>
#   MEMBERSHIP_CODE_EMAIL_FROM=GSI Chatbot <geosynthetic.institute@gmail.com>
# The From address must match SMTP_USERNAME; Gmail rewrites anything else.
# Limit is 500 recipients/day. Set it with ./scripts/set_email_provider.sh.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1
# Optional JSON array of extra demo GSI members, e.g.
# [{"email":"a@b.org","password":"secret","name":"A","organization_id":"gsi"}]
MEMBERSHIP_DEMO_MEMBERS=

# Conversation persistence (DynamoDB in AWS; in-memory when unset).
DYNAMODB_CONVERSATIONS_TABLE=
CONVERSATION_TTL_DAYS=90

# Frontend/API deployment helpers.
CORS_ALLOW_ORIGINS=
VITE_API_BASE_URL=

# Local JSON index path used by the dependency-light MVP.
STANDARDS_INDEX_PATH=data/index/standards-index.json

# Admin document library (/admin/*): who may see the corpus and upload new standards.
# Comma-separated sign-in emails, matched case-insensitively. Leave EMPTY and nobody
# is an admin - the dashboard entry point stays hidden and every /admin route 403s.
# Uploads are embedded into Pinecone, merged into STANDARDS_INDEX_PATH, and mirrored
# to STANDARDS_ASSETS_S3_URI so they survive a restart.
GSI_ADMIN_EMAILS=

# Question attachments (/chat/attachments): a PDF the asker brings, read alongside the
# library for one working session. Deliberately NOT ingested - no embedding, no Pinecone,
# no index merge, no S3 - so the only cost of an attached question is one PDF text
# extraction plus the prompt characters below. All three are optional; defaults shown.
# CHAT_ATTACHMENT_TTL_SECONDS=21600    # how long a read file stays available (6 hours)
# CHAT_ATTACHMENT_CACHE_SIZE=40        # how many are held at once; oldest evicted first
# CHAT_ATTACHMENT_PROMPT_CHARS=6000    # how much of the document may reach the model per question

# Optional: restrict PDF download (/documents/.../pdf) to files under this directory (absolute path).
# Leave unset for local dev when source_path in the index already points to allowed PDFs.
# STANDARDS_PDF_ROOT=/path/to/standards/pdfs

# Pinecone vector retrieval (optional).
USE_PINECONE=0
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=
PINECONE_INDEX_HOST=
PINECONE_EMBED_MODEL=llama-text-embed-v2
PINECONE_EMBED_TRUNCATE=END
PINECONE_UPSERT_BATCH=64

# Video transcript retrieval (links questions to YouTube videos).
# JSON file of transcripts; see data/videos/transcripts.json for the format.
VIDEO_TRANSCRIPTS_PATH=data/videos/transcripts.json
# Optional: enrich video metadata via the YouTube Data API (embedding works without it).
YOUTUBE_API_KEY=
